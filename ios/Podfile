# Voltcore iOS Podfile.
#
# Flutter's standard template, plus the `GCC_PREPROCESSOR_DEFINITIONS` block at
# the bottom that permission_handler needs. Read that block's comment before
# changing anything there — the defaults are not what most Podfile snippets on
# the internet assume.
#
# 12.0 matches Runner.xcodeproj's IPHONEOS_DEPLOYMENT_TARGET and is the highest
# floor among the plugins in use (permission_handler_apple, file_picker and
# image_picker_ios all want 12.0; geolocator_apple wants 11.0). Setting it here
# as well keeps CocoaPods from silently building pods against a lower target
# than the app.
platform :ios, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # ===================================================================
      # permission_handler: which permissions get compiled into the binary
      # ===================================================================
      #
      # ⚠️ THE DEFAULT IS OFF, NOT ON.
      #
      # permission_handler_apple guards every permission behind a macro, and
      # PermissionHandlerEnums.h defines each one to 0 when the Podfile does
      # not. Its podspec sets no defaults. So with no block here, EVERY
      # permission is compiled out and every check returns `denied` on iOS —
      # silently, with a green build.
      #
      # Most Podfile snippets you will find set `PERMISSION_X=0` for the
      # permissions an app does NOT want, assuming the rest default to on.
      # That is backwards for this version and would ship an app where the
      # camera button does nothing. Enable what is used; leave the rest alone.
      #
      # Why not just enable everything: referencing an iOS permission API with
      # no matching usage description in Info.plist is an App Store rejection
      # (ITMS-90683). Each `=1` below has its key in ios/Runner/Info.plist, and
      # adding another one here means adding its key there in the same change.
      #
      # ---- Mapping from the Android manifest -----------------------------
      #
      #   Android                        iOS
      #   ---------------------------    ------------------------------------
      #   CAMERA                         PERMISSION_CAMERA
      #                                  + NSCameraUsageDescription
      #   READ_MEDIA_IMAGES /            PERMISSION_PHOTOS
      #   READ_EXTERNAL_STORAGE          + NSPhotoLibrary[Add]UsageDescription
      #   ACCESS_FINE_LOCATION /         PERMISSION_LOCATION_WHENINUSE
      #   ACCESS_COARSE_LOCATION         + NSLocationWhenInUseUsageDescription
      #
      #   INTERNET, ACCESS_NETWORK_STATE  no iOS equivalent — the network is
      #                                   not a permission on iOS
      #   WRITE/READ_EXTERNAL_STORAGE     no equivalent — iOS sandboxes the
      #                                   app's own documents; the existing
      #                                   NSDocumentsFolderUsageDescription
      #                                   covers the PDF export
      #   POST_NOTIFICATIONS              flutter_local_notifications asks for
      #                                   this itself on iOS, not through
      #                                   permission_handler, so no macro
      #   READ/WRITE_CALENDAR             Android has these for ACTION_INSERT
      #                                   intents. iOS has no such intent and
      #                                   the app never touches EventKit, so
      #                                   enabling PERMISSION_EVENTS would
      #                                   compile in calendar code nothing
      #                                   calls — and demand a
      #                                   NSCalendarsUsageDescription the app
      #                                   has no honest reason to ship.
      #
      # PERMISSION_LOCATION and PERMISSION_LOCATION_ALWAYS stay off on purpose.
      # The app only ever asks for `Permission.locationWhenInUse`, and the
      # "always" strategy wants NSLocationAlwaysAndWhenInUseUsageDescription —
      # exactly the kind of unbacked reference ITMS-90683 rejects.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
      ]
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        ## dart: Permission.camera — photo attachments on inspections
        ##       and maintenance.
        'PERMISSION_CAMERA=1',

        ## dart: Permission.photos — attaching an existing photo, and the
        ##       Android storage fallback in AppPermissions.
        'PERMISSION_PHOTOS=1',

        ## dart: Permission.locationWhenInUse — site check-in.
        'PERMISSION_LOCATION_WHENINUSE=1',
      ]
    end
  end
end
