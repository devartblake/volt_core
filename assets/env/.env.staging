SUPABASE_ANON_KEY="sb_publishable_9kWLzjEAPzgeiarFOAtSSw_dVrft56J"
SUPABASE_SERVICE_ROLE_KEY="staging_service_key"

# Supabase Storage bucket for PDF + signature cloud backup
SUPABASE_STORAGE_BUCKET="voltcore-files"

# Active tenant UUID stamped on every synced row (required for cloud sync).
SUPABASE_TENANT_ID=""

APP_NAME="Voltcore Staging"
API_BASE_URL="https://staging.api.voltcore.com"
PDF_OUTPUT_PATH="AandSElectric/Staging"

# Email: sending is server-side via the `send-report-email` Edge Function.
# SMTP secrets live as Edge Function secrets, not in this bundle. Only SMTP_TO
# (default recipient) is read by the client.
SMTP_TO="office@aselectricnyc.com"

# Optional secure overrides
USE_SECURE_ENV=false
SECURE_SUPABASE_URL=""
SECURE_SUPABASE_ANON_KEY=""

# Observability
SENTRY_DSN="https://xxxx@sentry.io/12345"
CRASHLYTICS_API_KEY="your-crashlytics-key"

# App metadata (nice-to-have, especially for CI)
APP_ICON_NAME="ic_launcher"
BUNDLE_ID="com.theoreticalminds.voltcore.dev"